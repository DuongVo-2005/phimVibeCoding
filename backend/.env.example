# ==== App ====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001
# Gốc URL công khai để dựng URL tuyệt đối cho file đã upload (POST /uploads/image trả về
# `${PUBLIC_BASE_URL}/uploads/<filename>`) — đổi thành domain thật khi deploy production.
PUBLIC_BASE_URL=http://localhost:3000
# Gốc URL frontend — dùng để dựng link xác thực email (`${FRONTEND_URL}/xac-thuc-email?token=...`).
FRONTEND_URL=http://localhost:3001

# ==== MongoDB ====
MONGODB_URI=mongodb://localhost:27017/rophim

# ==== JWT ====
# Generate strong random values, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_VERIFICATION_SECRET=replace_with_yet_another_long_random_secret
JWT_EMAIL_VERIFICATION_EXPIRES=24h

# ==== Mail (Phase 33 — Verify Email) ====
# Để trống MAIL_HOST -> chưa cấu hình SMTP, MailService tự log token xác thực ra console (dev-only,
# giữ nguyên pattern đã dùng cho forgot-password). Điền đủ 5 biến bên dưới để gửi email thật qua SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="RoPhim" <no-reply@rophim.local>

# ==== Admin seed (used only by `npm run seed:admin`) ====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Administrator

# ==== Ophim crawler ====
OPHIM_API_BASE_URL=https://ophim1.com
OPHIM_SYNC_LIST_CRON=*/30 * * * *
OPHIM_SYNC_TYPES_CRON=0 3 * * *
OPHIM_REQUEST_CONCURRENCY=3
OPHIM_SYNC_LIST_MAX_PAGES=3
OPHIM_CRAWLER_ENABLED=true

# ==== Throttler (rate limit) ====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==== Redis (optional — reserved for future BullMQ/cache upgrade, not required to run) ====
# REDIS_URL=redis://localhost:6379
